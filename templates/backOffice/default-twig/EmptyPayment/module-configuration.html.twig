{# Configuration fragment, rendered inside the module-configure page #}
<div class="card mb-4">
    <div class="card-header">
        {{ 'Payment on account'|trans({}, 'emptypayment.bo.default-twig') }}
    </div>
    <div class="card-body">
        <p class="form-text">{{ 'This payment is always valid: restrict it to the customers allowed to pay on account with a payment rule module.'|trans({}, 'emptypayment.bo.default-twig') }}</p>
        {% form_theme form with bo_form_themes only %}
        {{ form_start(form, {attr: {id: 'empty-payment-form'}, method: 'POST', action: path('empty_payment.admin.configuration')}) }}
            {{ form_errors(form) }}
            {{ form_row(form.order_status_code) }}
            <button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, 'emptypayment.bo.default-twig') }}</button>
        {{ form_end(form) }}
    </div>
</div>
